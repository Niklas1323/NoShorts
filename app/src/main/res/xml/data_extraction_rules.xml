<?xml version="1.0" encoding="utf-8"?>
<!--
  Nichts sichern, nichts auf ein neues Handy übertragen: Profilbild-Ausschnitt, Einstellungen und Fehler-Dateien
  bleiben auf diesem Gerät (so steht es in der Datenschutzerklärung). allowBackup="false" schaltet ab Android 12
  nur das Cloud-Backup ab, nicht die Übertragung von Gerät zu Gerät – darum diese Regeln.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
