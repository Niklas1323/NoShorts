<?xml version="1.0" encoding="utf-8"?>
<!--
    Kein packageNames-Filter: Wir müssen merken, wenn eine andere App nach vorne kommt,
    damit unsere Leiste sofort verschwindet. Inhalte anderer Apps werden nicht gelesen,
    der Service bricht bei fremden Apps sofort ab.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled|typeViewClicked|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/a11y_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0"
    android:settingsActivity="app.fshorts.MainActivity" />
