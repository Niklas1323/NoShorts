<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Nur für Kauf und Abo (Superwall, Google Play). YouTube-Inhalte verlassen das Handy nie. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Superwall bringt Benachrichtigungen mit (Erinnerung vor Ende der Testzeit): brauchen wir nicht. -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:node="remove" />

    <!-- Nur um die YouTube-Version in die Struktur-Dumps zu schreiben. -->
    <queries>
        <package android:name="com.google.android.youtube" />
    </queries>

    <application
        android:name=".FShortsApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FuckShorts">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Paywall von Superwall (laut Superwall-Anleitung). -->
        <activity
            android:name="com.superwall.sdk.paywall.view.SuperwallPaywallActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />
        <activity android:name="com.superwall.sdk.debug.DebugViewActivity" />
        <activity android:name="com.superwall.sdk.debug.localizations.SWLocalizationActivity" />
        <activity android:name="com.superwall.sdk.debug.SWConsoleActivity" />

        <service
            android:name=".service.FuckShortsService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
